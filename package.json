{
  "name": "financial-decision-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite --configLoader runner --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "test": "tsx --test tests/*.test.ts",
    "start": "tsx src/server/index.ts"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "@napi-rs/canvas": "0.1.80",
    "express": "5.1.0",
    "fflate": "0.8.3",
    "pdfjs-dist": "5.4.296",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.5",
    "@types/node": "24.10.0",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "concurrently": "9.2.5",
    "fast-check": "4.8.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  }
}
